# Copy this file to .env.local and fill in your keys.
# Get Composio key: https://platform.composio.dev/settings
# Get Gemini key: https://aistudio.google.com/app/apikey
COMPOSIO_API_KEY=your_composio_api_key
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key

# Optional: require Authorization: Bearer <CRON_SECRET> for GET /api/cron/run-flows (leave unset to allow unauthenticated cron)
# CRON_SECRET=
